#!/usr/bin/env bash
set -euo pipefail

SESSION_PREFIX="claude"
PRIME_DELAY=3  # seconds to wait for Claude to start
ZOMBIE_GRACE_PERIOD=10  # seconds after session creation before marking as zombie
HEARTBEAT_FRESH=300   # 5 minutes - heartbeat considered fresh
HEARTBEAT_STALE=900   # 15 minutes - heartbeat considered stale
HEARTBEAT_DIR="/tmp/mob-heartbeats"
LOCK_DIR="/tmp/mob-locks"
LOG_DIR="/tmp/mob-logs"
INBOX_DIR="/tmp/mob-inbox"

WORKER_TOOLS='Read,Write,Edit,Glob,Grep,Bash(mob:*,git:*,npm:*,npx:*,pnpm:*,yarn:*,make:*,jest:*,vitest:*,pytest:*,cargo:*),WebSearch,WebFetch,Task,TodoWrite'
REVIEWER_TOOLS='Read,Glob,Grep,Bash(mob:*,git:*,npm:test,npm:lint,npx:*,pnpm:test,pnpm:lint,yarn:test,yarn:lint,make:test,make:lint,jest:*,vitest:*,pytest:*,cargo:test,cargo:clippy),WebSearch,WebFetch,Task,TodoWrite'
RESEARCHER_TOOLS='Read,Glob,Grep,Bash(mob:*),WebSearch,WebFetch,Task,TodoWrite'
PLANNER_TOOLS='Read,Glob,Grep,Bash(mob:*),WebSearch,WebFetch,Task,TodoWrite'
OPERATOR_TOOLS='Read,Glob,Grep,Bash(mob:*),WebSearch,WebFetch,Task,TodoWrite'

read -r -d '' COORD_PROMPT << 'EOF' || true
You are a **coordinator** running in the background, managed by an Operator. Your job:
1. Check priority inbox FIRST: `mob priority` (messages from Operator)
2. Then check worker inbox: `mob inbox` (completions from workers)
3. Break tasks into subtasks and dispatch workers
4. Handle worker questions/crashes autonomously when possible
5. Report significant results back: `mob report "summary for operator"`

**PRIORITY INBOX**: Always check `mob priority` before `mob inbox`. Operator messages take precedence.

**CRITICAL: Use `mob dispatch`, NOT the Task tool!**
- `mob dispatch` spawns real tmux workers with full write permissions
- The Task tool spawns subagents that CANNOT write files (permission blocked)
- NEVER use Task/subagents for work that requires writing code

Worker types (choose based on task):
- worker: implement, fix bugs, write code, write tests (full read/write/bash access)
- researcher: understand code, find patterns, explore (read-only, safe to spawn liberally)
- planner: design architecture, break down complex problems (opus model, for hard thinking)
- reviewer: validate changes, code review, run tests (read + test/lint commands)

Patterns:
- Simple bug fix → worker
- New feature → researcher → planner → worker(s) → reviewer
- Code question → researcher
- Refactor → planner → worker(s) → reviewer
- PR review → reviewer
- Write tests → worker (NOT Task tool)

Commands: `mob dispatch <type> <id> <task>`, `mob priority`, `mob inbox`, `mob workers`, `mob kill <session>`, `mob report <msg>`

Work autonomously. Handle worker questions yourself unless truly blocked. Report progress to the Operator.
EOF

read -r -d '' WORKER_PROMPT << 'EOF' || true
You are a **worker** in a multi-agent swarm. A coordinator assigned you a task.

When finished: `mob done "summary of what you built"`
If stuck: `mob ask "your question"`
Progress update: `mob report "status"`

Focus only on your assigned task. Don't wait for confirmation after `mob done`.
EOF

read -r -d '' REVIEWER_PROMPT << 'EOF' || true
You are a **reviewer** in a multi-agent swarm. A coordinator assigned you a code review task.

Your role is READ-ONLY with testing capabilities: You can explore code, run tests/linters to validate quality, but you CANNOT modify any files.

When finished: `mob done "summary of your review findings"`
If stuck: `mob ask "your question"`
Progress update: `mob report "status"`

Focus only on your assigned review task. Don't wait for confirmation after `mob done`.
EOF

read -r -d '' RESEARCHER_PROMPT << 'EOF' || true
You are a **researcher** in a multi-agent swarm. A coordinator assigned you a research task.

Your role is READ-ONLY: You can explore code, search files, and gather information, but you CANNOT modify any files or execute commands that change the system.

When finished: `mob done "summary of your findings"`
If stuck: `mob ask "your question"`
Progress update: `mob report "status"`

Focus only on your assigned research task. Don't wait for confirmation after `mob done`.
EOF

read -r -d '' PLANNER_PROMPT << 'EOF' || true
You are a **planner** in a multi-agent swarm. A coordinator assigned you a planning/design task.

Your role is PLANNING ONLY: You can explore code and think deeply about architecture and design, but you CANNOT modify any files. You use the opus model for complex reasoning.

When finished: `mob done "summary of your plan/design"`
If stuck: `mob ask "your question"`
Progress update: `mob report "status"`

Focus only on your assigned planning task. Don't wait for confirmation after `mob done`.
EOF

read -r -d '' OPERATOR_PROMPT << 'EOF' || true
You are the **operator** - the user's interface to the mob swarm. You shield them from worker noise.

Your job:
1. Accept tasks from the user and translate them into coordinator instructions
2. Send tasks to coordinator: `mob task "detailed instructions"`
3. Check coordinator reports: `mob results`
4. Monitor swarm health: `mob health`, `mob workers`
5. Summarize and present results to the user

**You do NOT talk directly to workers.** The coordinator handles all worker management.

Flow:
1. User gives you a task
2. You clarify if needed, then `mob task "..."` to coordinator
3. Periodically check `mob results` for coordinator reports
4. When work completes, synthesize and present to user

Commands:
- `mob task "instructions"` - Send priority task to coordinator
- `mob results` - Read coordinator's reports to you
- `mob health` - Check swarm status
- `mob workers` - List active workers
- `mob peek claude-coord-*` - See coordinator's recent activity

You are the calm interface. Let the coordinator handle the chaos.
EOF

_acquire_lock() {
    local session="$1"
    local lockdir="$LOCK_DIR/${session}.lock"
    local max_attempts=30
    local attempt=0

    mkdir -p "$LOCK_DIR"

    while ! mkdir "$lockdir" 2>/dev/null; do
        ((attempt++))
        if [[ $attempt -ge $max_attempts ]]; then
            echo "Failed to acquire lock for $session after ${max_attempts}s" >&2
            return 1
        fi
        sleep 1
    done

    trap "_release_lock '$session'" EXIT
    return 0
}

_release_lock() {
    local session="$1"
    local lockdir="$LOCK_DIR/${session}.lock"
    rmdir "$lockdir" 2>/dev/null || true
}

_send_keys_locked() {
    local session="$1"
    shift
    local message="$*"

    (
        _acquire_lock "$session" || exit 1
        tmux send-keys -t "$session" -l "$message"
        sleep 0.3
        tmux send-keys -t "$session" Enter
        _release_lock "$session"
    )
}

setup_crash_detection() {
    local session="$1"
    local mob_path
    mob_path=$(realpath "$0")
    tmux set-hook -t "$session" pane-died "run-shell '$mob_path crash $session'"
}

spawn() {
    local role="$1"
    local id="${2:-$(date +%s)}"
    local name="${SESSION_PREFIX}-${role}-${id}"

    if tmux has-session -t "$name" 2>/dev/null; then
        echo "Session $name already exists" >&2
        return 1
    fi

    tmux new-session -d -s "$name"
    sleep 0.2

    if [[ "$role" == "worker"* ]]; then
        tmux send-keys -t "$name" "claude --model sonnet --dangerously-skip-permissions --setting-sources '' --allowedTools '$WORKER_TOOLS'" Enter
        setup_crash_detection "$name"
    elif [[ "$role" == "researcher"* ]]; then
        tmux send-keys -t "$name" "claude --model sonnet --dangerously-skip-permissions --setting-sources '' --allowedTools '$RESEARCHER_TOOLS'" Enter
        setup_crash_detection "$name"
    elif [[ "$role" == "reviewer"* ]]; then
        tmux send-keys -t "$name" "claude --model sonnet --dangerously-skip-permissions --setting-sources '' --allowedTools '$REVIEWER_TOOLS'" Enter
        setup_crash_detection "$name"
    elif [[ "$role" == "planner"* ]]; then
        tmux send-keys -t "$name" "claude --model opus --dangerously-skip-permissions --setting-sources '' --allowedTools '$PLANNER_TOOLS'" Enter
        setup_crash_detection "$name"
    elif [[ "$role" == "operator"* ]]; then
        tmux send-keys -t "$name" "claude --model opus --dangerously-skip-permissions --setting-sources '' --allowedTools '$OPERATOR_TOOLS'" Enter
    else
        tmux send-keys -t "$name" "claude" Enter
    fi

    # Auto-prime based on role
    if [[ "$role" == "coord"* ]]; then
        echo "Waiting ${PRIME_DELAY}s for Claude to start..."
        sleep "$PRIME_DELAY"
        tmux send-keys -t "$name" -l "$COORD_PROMPT"
        sleep 0.3
        tmux send-keys -t "$name" Enter
        echo "$name (primed as coordinator)"
    elif [[ "$role" == "worker"* ]]; then
        echo "Waiting ${PRIME_DELAY}s for Claude to start..."
        sleep "$PRIME_DELAY"
        tmux send-keys -t "$name" -l "$WORKER_PROMPT"
        sleep 0.3
        tmux send-keys -t "$name" Enter
        echo "$name (primed as worker, crash detection enabled)"
    elif [[ "$role" == "researcher"* ]]; then
        echo "Waiting ${PRIME_DELAY}s for Claude to start..."
        sleep "$PRIME_DELAY"
        tmux send-keys -t "$name" -l "$RESEARCHER_PROMPT"
        sleep 0.3
        tmux send-keys -t "$name" Enter
        echo "$name (primed as researcher, crash detection enabled)"
    elif [[ "$role" == "reviewer"* ]]; then
        echo "Waiting ${PRIME_DELAY}s for Claude to start..."
        sleep "$PRIME_DELAY"
        tmux send-keys -t "$name" -l "$REVIEWER_PROMPT"
        sleep 0.3
        tmux send-keys -t "$name" Enter
        echo "$name (primed as reviewer, crash detection enabled)"
    elif [[ "$role" == "planner"* ]]; then
        echo "Waiting ${PRIME_DELAY}s for Claude to start..."
        sleep "$PRIME_DELAY"
        tmux send-keys -t "$name" -l "$PLANNER_PROMPT"
        sleep 0.3
        tmux send-keys -t "$name" Enter
        echo "$name (primed as planner with opus, crash detection enabled)"
    elif [[ "$role" == "operator"* ]]; then
        echo "Waiting ${PRIME_DELAY}s for Claude to start..."
        sleep "$PRIME_DELAY"
        tmux send-keys -t "$name" -l "$OPERATOR_PROMPT"
        sleep 0.3
        tmux send-keys -t "$name" Enter
        echo "$name (primed as operator with opus)"
    else
        echo "$name (no auto-prime for role: $role)"
    fi
}

spawn_quiet() {
    local role="$1"
    local id="${2:-$(date +%s)}"
    local name="${SESSION_PREFIX}-${role}-${id}"

    if tmux has-session -t "$name" 2>/dev/null; then
        echo "Session $name already exists" >&2
        return 1
    fi

    mkdir -p "$LOG_DIR"
    tmux new-session -d -s "$name"
    sleep 0.2
    tmux pipe-pane -t "$name" -o "cat >> '$LOG_DIR/$name.log'"
    tmux send-keys -t "$name" "claude" Enter
    echo "$name"
}

dispatch() {
    local role="$1"
    local id="$2"
    local task="$3"
    local name="${SESSION_PREFIX}-${role}-${id}"

    spawn "$role" "$id" >/dev/null
    sleep 0.5
    _send_keys_locked "$name" "$task"
    echo "Dispatched to $name"
}

list_sessions() {
    tmux list-sessions -F "#{session_name}" 2>/dev/null \
        | grep "^${SESSION_PREFIX}-" \
        || echo "No claude sessions running"
}

workers() {
    tmux list-sessions -F "#{session_name}" 2>/dev/null \
        | grep "^${SESSION_PREFIX}-worker" \
        || echo "No workers running"
}

coord() {
    local coord_session
    coord_session=$(tmux list-sessions -F "#{session_name}" 2>/dev/null \
        | grep "^${SESSION_PREFIX}-coord" \
        | head -1 || true)

    if [[ -z "$coord_session" ]]; then
        echo "No coordinator found" >&2
        return 1
    fi

    echo "$coord_session"
}

operator() {
    local operator_session
    operator_session=$(tmux list-sessions -F "#{session_name}" 2>/dev/null \
        | grep "^${SESSION_PREFIX}-operator" \
        | head -1 || true)

    if [[ -z "$operator_session" ]]; then
        echo "No operator found" >&2
        return 1
    fi

    echo "$operator_session"
}

report() {
    local message="$*"
    local sender
    sender=$(tmux display-message -p "#{session_name}" 2>/dev/null || echo "unknown")

    mkdir -p "$INBOX_DIR"

    if [[ "$sender" == "${SESSION_PREFIX}-coord"* ]]; then
        local operator_session
        operator_session=$(tmux list-sessions -F "#{session_name}" 2>/dev/null \
            | grep "^${SESSION_PREFIX}-operator" \
            | head -1 || true)
        if [[ -z "$operator_session" ]]; then
            echo "No operator to report to" >&2
            return 1
        fi
        echo "{\"type\":\"REPORT\",\"from\":\"$sender\",\"message\":\"$message\",\"ts\":$(date +%s)}" >> "$INBOX_DIR/${operator_session}-results.jsonl"
        echo "Report queued for $operator_session (check with: mob results)"
    else
        local coord_session
        coord_session=$(coord 2>/dev/null) || {
            echo "No coordinator to report to" >&2
            return 1
        }
        echo "{\"type\":\"REPORT\",\"from\":\"$sender\",\"message\":\"$message\",\"ts\":$(date +%s)}" >> "$INBOX_DIR/$coord_session.jsonl"
        echo "Report queued for $coord_session (check with: mob inbox)"
    fi
}

done_task() {
    local task_summary="$*"

    local sender
    sender=$(tmux display-message -p "#{session_name}" 2>/dev/null || echo "unknown")

    if [[ "$sender" != "${SESSION_PREFIX}-worker"* ]] && \
       [[ "$sender" != "${SESSION_PREFIX}-researcher"* ]] && \
       [[ "$sender" != "${SESSION_PREFIX}-reviewer"* ]] && \
       [[ "$sender" != "${SESSION_PREFIX}-planner"* ]]; then
        echo "Only workers can call 'mob done' (you are: $sender)" >&2
        return 1
    fi

    local coord_session
    coord_session=$(coord 2>/dev/null) || {
        echo "No coordinator to report to" >&2
        return 1
    }

    mkdir -p "$INBOX_DIR"
    echo "{\"type\":\"DONE\",\"from\":\"$sender\",\"message\":\"$task_summary\",\"ts\":$(date +%s)}" >> "$INBOX_DIR/$coord_session.jsonl"

    echo "Completion queued for $coord_session (check with: mob inbox)"

    sleep 1
    tmux kill-session -t "$sender" 2>/dev/null &
}

ask_coord() {
    local question="$*"
    local coord_session
    coord_session=$(coord 2>/dev/null) || {
        echo "No coordinator to ask" >&2
        return 1
    }

    local sender
    sender=$(tmux display-message -p "#{session_name}" 2>/dev/null || echo "unknown")

    tmux send-keys -t "$coord_session" -l "[QUESTION from $sender] $question"
    sleep 0.3
    tmux send-keys -t "$coord_session" Enter

    echo "Question sent to $coord_session (interrupt)"
}

inbox() {
    local coord_session
    coord_session=$(tmux display-message -p "#{session_name}" 2>/dev/null || echo "unknown")

    if [[ "$coord_session" != "${SESSION_PREFIX}-coord"* ]]; then
        coord_session=$(coord 2>/dev/null) || {
            echo "No coordinator found" >&2
            return 1
        }
    fi

    local inbox_file="$INBOX_DIR/$coord_session.jsonl"

    if [[ ! -f "$inbox_file" ]] || [[ ! -s "$inbox_file" ]]; then
        echo "No messages in inbox"
        return 0
    fi

    local count
    count=$(wc -l < "$inbox_file" | tr -d ' ')
    echo "=== INBOX ($count messages) ==="
    echo ""

    while IFS= read -r line; do
        local msg_type msg_from msg_text
        msg_type=$(echo "$line" | sed -n 's/.*"type":"\([^"]*\)".*/\1/p')
        msg_from=$(echo "$line" | sed -n 's/.*"from":"\([^"]*\)".*/\1/p')
        msg_text=$(echo "$line" | sed -n 's/.*"message":"\([^"]*\)".*/\1/p')
        echo "[$msg_type from $msg_from] $msg_text"
    done < "$inbox_file"

    rm -f "$inbox_file"
    echo ""
    echo "--- Inbox cleared ---"
}

inbox_count() {
    local coord_session
    coord_session=$(tmux display-message -p "#{session_name}" 2>/dev/null || echo "unknown")

    if [[ "$coord_session" != "${SESSION_PREFIX}-coord"* ]]; then
        coord_session=$(coord 2>/dev/null) || {
            echo "0"
            return 0
        }
    fi

    local inbox_file="$INBOX_DIR/$coord_session.jsonl"

    if [[ ! -f "$inbox_file" ]] || [[ ! -s "$inbox_file" ]]; then
        echo "0"
        return 0
    fi

    wc -l < "$inbox_file" | tr -d ' '
}

task() {
    local message="$*"
    local coord_session
    coord_session=$(coord 2>/dev/null) || {
        echo "No coordinator found" >&2
        return 1
    }

    local sender
    sender=$(tmux display-message -p "#{session_name}" 2>/dev/null || echo "unknown")

    mkdir -p "$INBOX_DIR"
    local priority_file="$INBOX_DIR/${coord_session}-priority.jsonl"
    echo "{\"type\":\"TASK\",\"from\":\"$sender\",\"message\":\"$message\",\"ts\":$(date +%s)}" >> "$priority_file"

    _send_keys_locked "$coord_session" "[PRIORITY] New task from operator. Run: mob priority"

    echo "Priority task sent to $coord_session"
}

priority() {
    local coord_session
    coord_session=$(tmux display-message -p "#{session_name}" 2>/dev/null || echo "unknown")

    if [[ "$coord_session" != "${SESSION_PREFIX}-coord"* ]]; then
        echo "Only coordinators can check priority inbox" >&2
        return 1
    fi

    local priority_file="$INBOX_DIR/${coord_session}-priority.jsonl"

    if [[ ! -f "$priority_file" ]] || [[ ! -s "$priority_file" ]]; then
        echo "No priority messages"
        return 0
    fi

    local count
    count=$(wc -l < "$priority_file" | tr -d ' ')
    echo "=== PRIORITY INBOX ($count messages) ==="
    echo ""

    while IFS= read -r line; do
        local msg_type msg_from msg_text
        msg_type=$(echo "$line" | sed -n 's/.*"type":"\([^"]*\)".*/\1/p')
        msg_from=$(echo "$line" | sed -n 's/.*"from":"\([^"]*\)".*/\1/p')
        msg_text=$(echo "$line" | sed -n 's/.*"message":"\([^"]*\)".*/\1/p')
        echo "[$msg_type from $msg_from] $msg_text"
    done < "$priority_file"

    rm -f "$priority_file"
    echo ""
    echo "--- Priority inbox cleared ---"
}

results() {
    local operator_session
    operator_session=$(tmux display-message -p "#{session_name}" 2>/dev/null || echo "unknown")

    if [[ "$operator_session" != "${SESSION_PREFIX}-operator"* ]]; then
        operator_session=$(tmux list-sessions -F "#{session_name}" 2>/dev/null \
            | grep "^${SESSION_PREFIX}-operator" \
            | head -1 || true)
        if [[ -z "$operator_session" ]]; then
            echo "No operator found" >&2
            return 1
        fi
    fi

    local results_file="$INBOX_DIR/${operator_session}-results.jsonl"

    if [[ ! -f "$results_file" ]] || [[ ! -s "$results_file" ]]; then
        echo "No results from coordinator"
        return 0
    fi

    local count
    count=$(wc -l < "$results_file" | tr -d ' ')
    echo "=== COORDINATOR REPORTS ($count messages) ==="
    echo ""

    while IFS= read -r line; do
        local msg_from msg_text
        msg_from=$(echo "$line" | sed -n 's/.*"from":"\([^"]*\)".*/\1/p')
        msg_text=$(echo "$line" | sed -n 's/.*"message":"\([^"]*\)".*/\1/p')
        echo "[from $msg_from] $msg_text"
    done < "$results_file"

    rm -f "$results_file"
    echo ""
    echo "--- Results cleared ---"
}

heartbeat() {
    mkdir -p "$HEARTBEAT_DIR"
    local sender
    sender=$(tmux display-message -p "#{session_name}" 2>/dev/null || echo "unknown")

    if [[ "$sender" == "unknown" ]]; then
        echo "Cannot determine session name" >&2
        return 1
    fi

    echo "$(date +%s)" > "$HEARTBEAT_DIR/$sender"
    echo "Heartbeat recorded for $sender"
}

get_heartbeat_age() {
    local session="$1"
    local heartbeat_file="$HEARTBEAT_DIR/$session"

    if [[ ! -f "$heartbeat_file" ]]; then
        echo "-1"
        return
    fi

    local last_beat
    last_beat=$(cat "$heartbeat_file" 2>/dev/null || echo "0")
    local now
    now=$(date +%s)
    echo $((now - last_beat))
}

get_heartbeat_status() {
    local session="$1"
    local age
    age=$(get_heartbeat_age "$session")

    if [[ $age -eq -1 ]]; then
        echo "none"
    elif [[ $age -lt $HEARTBEAT_FRESH ]]; then
        echo "fresh"
    elif [[ $age -lt $HEARTBEAT_STALE ]]; then
        echo "aging"
    else
        echo "stale"
    fi
}

crash_handler() {
    local crashed_session="$1"
    local coord_session
    coord_session=$(tmux list-sessions -F "#{session_name}" 2>/dev/null \
        | grep "^${SESSION_PREFIX}-coord" \
        | head -1 || true)

    if [[ -z "$coord_session" ]]; then
        echo "Worker $crashed_session crashed (no coordinator to notify)" >&2
        return 0
    fi

    if ! tmux has-session -t "$coord_session" 2>/dev/null; then
        echo "Worker $crashed_session crashed (coordinator session gone)" >&2
        return 0
    fi

    tmux send-keys -t "$coord_session" -l "[CRASH from $crashed_session] Worker terminated unexpectedly"
    sleep 0.3
    tmux send-keys -t "$coord_session" Enter

    echo "Crash notification sent to $coord_session"
}

is_claude_running_in_session() {
    local session="$1"
    local pane_pid
    pane_pid=$(tmux list-panes -t "$session" -F "#{pane_pid}" 2>/dev/null | head -1)

    if [[ -z "$pane_pid" ]]; then
        return 1
    fi

    if ps -o pid,comm -g "$pane_pid" 2>/dev/null | grep -qE "claude|node"; then
        return 0
    fi

    local children
    children=$(pgrep -P "$pane_pid" 2>/dev/null || true)
    for child in $children; do
        if ps -o comm= -p "$child" 2>/dev/null | grep -qE "claude|node"; then
            return 0
        fi
        local grandchildren
        grandchildren=$(pgrep -P "$child" 2>/dev/null || true)
        for gc in $grandchildren; do
            if ps -o comm= -p "$gc" 2>/dev/null | grep -qE "claude|node"; then
                return 0
            fi
        done
    done

    return 1
}

get_session_health() {
    local session="$1"
    local created
    created=$(tmux list-sessions -F "#{session_name}|#{session_created}" 2>/dev/null \
        | grep "^${session}|" | cut -d'|' -f2)

    local now
    now=$(date +%s)
    local age=$((now - created))

    if [[ $age -lt $ZOMBIE_GRACE_PERIOD ]]; then
        echo "starting"
        return 0
    fi

    if ! is_claude_running_in_session "$session"; then
        echo "zombie"
        return 0
    fi

    local hb_status
    hb_status=$(get_heartbeat_status "$session")
    if [[ "$hb_status" == "stale" ]]; then
        echo "stuck"
        return 0
    fi

    echo "healthy"
}

health() {
    local sessions
    sessions=$(tmux list-sessions -F "#{session_name}|#{session_created}" 2>/dev/null | grep "^${SESSION_PREFIX}-" || true)

    if [[ -z "$sessions" ]]; then
        echo "No claude sessions running"
        return 0
    fi

    printf "%-30s %-10s %-10s %-12s %s\n" "SESSION" "STATUS" "AGE" "HEARTBEAT" "PANE_PID"
    printf "%-30s %-10s %-10s %-12s %s\n" "-------" "------" "---" "---------" "--------"

    echo "$sessions" | while IFS='|' read -r name created; do
        local status
        status=$(get_session_health "$name")

        local now
        now=$(date +%s)
        local age=$((now - created))
        local age_fmt="${age}s"
        if [[ $age -ge 3600 ]]; then
            age_fmt="$((age / 3600))h$((age % 3600 / 60))m"
        elif [[ $age -ge 60 ]]; then
            age_fmt="$((age / 60))m$((age % 60))s"
        fi

        local pane_pid
        pane_pid=$(tmux list-panes -t "$name" -F "#{pane_pid}" 2>/dev/null | head -1 || echo "?")

        local status_display="$status"
        if [[ "$status" == "zombie" ]]; then
            status_display="ZOMBIE"
        elif [[ "$status" == "stuck" ]]; then
            status_display="STUCK"
        fi

        local hb_age
        hb_age=$(get_heartbeat_age "$name")
        local hb_display="none"
        if [[ $hb_age -ge 0 ]]; then
            local hb_status
            hb_status=$(get_heartbeat_status "$name")
            if [[ $hb_age -ge 3600 ]]; then
                hb_display="$((hb_age / 3600))h$((hb_age % 3600 / 60))m"
            elif [[ $hb_age -ge 60 ]]; then
                hb_display="$((hb_age / 60))m$((hb_age % 60))s"
            else
                hb_display="${hb_age}s"
            fi
            hb_display="$hb_display($hb_status)"
        fi

        printf "%-30s %-10s %-10s %-12s %s\n" "$name" "$status_display" "$age_fmt" "$hb_display" "$pane_pid"
    done
}

zombies() {
    local sessions
    sessions=$(tmux list-sessions -F "#{session_name}" 2>/dev/null | grep "^${SESSION_PREFIX}-" || true)

    if [[ -z "$sessions" ]]; then
        return 0
    fi

    while read -r session; do
        local status
        status=$(get_session_health "$session")
        if [[ "$status" == "zombie" ]]; then
            echo "$session"
        fi
    done <<< "$sessions"
}

reap() {
    local sessions
    sessions=$(tmux list-sessions -F "#{session_name}" 2>/dev/null | grep "^${SESSION_PREFIX}-" || true)

    if [[ -z "$sessions" ]]; then
        echo "No claude sessions running"
        return 0
    fi

    local reaped=0
    while read -r session; do
        local status
        status=$(get_session_health "$session")
        if [[ "$status" == "zombie" ]]; then
            tmux kill-session -t "$session"
            echo "Reaped zombie: $session"
            ((reaped++)) || true
        fi
    done <<< "$sessions"

    if [[ $reaped -eq 0 ]]; then
        echo "No zombies to reap"
    else
        echo "Reaped $reaped zombie session(s)"
    fi
}

send_message() {
    local session="$1"
    shift
    local message="$*"

    if ! tmux has-session -t "$session" 2>/dev/null; then
        echo "Session $session does not exist" >&2
        return 1
    fi

    _send_keys_locked "$session" "$message"
    echo "Sent to $session"
}

kill_session() {
    local session="$1"

    if tmux has-session -t "$session" 2>/dev/null; then
        tmux kill-session -t "$session"
        echo "Killed $session"
    else
        echo "Session $session does not exist" >&2
        return 1
    fi
}

kill_all() {
    local sessions
    sessions=$(tmux list-sessions -F "#{session_name}" 2>/dev/null | grep "^${SESSION_PREFIX}-" || true)

    if [[ -z "$sessions" ]]; then
        echo "No claude sessions to kill"
        return 0
    fi

    echo "$sessions" | while read -r session; do
        tmux kill-session -t "$session"
        echo "Killed $session"
    done
}

attach() {
    local session="$1"

    if ! tmux has-session -t "$session" 2>/dev/null; then
        echo "Session $session does not exist" >&2
        return 1
    fi

    tmux attach -t "$session"
}

start() {
    local id="${1:-$(date +%s)}"
    local coord_name="${SESSION_PREFIX}-coord-${id}"
    local operator_name="${SESSION_PREFIX}-operator-${id}"

    if tmux has-session -t "$coord_name" 2>/dev/null; then
        echo "Session $coord_name already exists" >&2
        return 1
    fi
    if tmux has-session -t "$operator_name" 2>/dev/null; then
        echo "Session $operator_name already exists" >&2
        return 1
    fi

    mkdir -p "$LOG_DIR"

    echo "Starting coordinator in background..."
    tmux new-session -d -s "$coord_name"
    sleep 0.2
    tmux pipe-pane -t "$coord_name" -o "cat >> '$LOG_DIR/$coord_name.log'"
    tmux send-keys -t "$coord_name" "claude --model sonnet --dangerously-skip-permissions --setting-sources '' --allowedTools '$WORKER_TOOLS'" Enter
    setup_crash_detection "$coord_name"
    sleep "$PRIME_DELAY"
    tmux send-keys -t "$coord_name" -l "$COORD_PROMPT"
    sleep 0.3
    tmux send-keys -t "$coord_name" Enter
    echo "$coord_name (background coordinator ready)"

    echo "Starting operator..."
    tmux new-session -d -s "$operator_name"
    sleep 0.2
    tmux pipe-pane -t "$operator_name" -o "cat >> '$LOG_DIR/$operator_name.log'"
    tmux send-keys -t "$operator_name" "claude --model opus --dangerously-skip-permissions --setting-sources '' --allowedTools '$OPERATOR_TOOLS'" Enter
    sleep "$PRIME_DELAY"
    tmux send-keys -t "$operator_name" -l "$OPERATOR_PROMPT"
    sleep 0.3
    tmux send-keys -t "$operator_name" Enter
    echo "$operator_name (operator ready)"

    echo ""
    echo "Attaching to operator. Coordinator runs in background."
    echo "Use 'mob task \"...\"' to send work to coordinator."
    echo "Use 'mob results' to check coordinator reports."
    echo ""
    tmux attach -t "$operator_name"
}

status() {
    local sessions
    sessions=$(tmux list-sessions -F "#{session_name}|#{session_created}|#{session_attached}" 2>/dev/null | grep "^${SESSION_PREFIX}-" || true)

    if [[ -z "$sessions" ]]; then
        echo "No claude sessions running"
        return 0
    fi

    printf "%-30s %-20s %s\n" "SESSION" "CREATED" "ATTACHED"
    printf "%-30s %-20s %s\n" "-------" "-------" "--------"

    echo "$sessions" | while IFS='|' read -r name created attached; do
        created_fmt=$(date -r "$created" "+%H:%M:%S" 2>/dev/null || echo "$created")
        attached_fmt=$([[ "$attached" == "1" ]] && echo "yes" || echo "no")
        printf "%-30s %-20s %s\n" "$name" "$created_fmt" "$attached_fmt"
    done
}

broadcast() {
    local message="$*"
    local sessions
    sessions=$(tmux list-sessions -F "#{session_name}" 2>/dev/null | grep "^${SESSION_PREFIX}-" || true)

    if [[ -z "$sessions" ]]; then
        echo "No claude sessions to broadcast to"
        return 0
    fi

    echo "$sessions" | while read -r session; do
        _send_keys_locked "$session" "$message"
        echo "Sent to $session"
    done
}

broadcast_workers() {
    local message="$*"
    local sessions
    sessions=$(tmux list-sessions -F "#{session_name}" 2>/dev/null | grep "^${SESSION_PREFIX}-worker" || true)

    if [[ -z "$sessions" ]]; then
        echo "No workers to broadcast to"
        return 0
    fi

    echo "$sessions" | while read -r session; do
        _send_keys_locked "$session" "$message"
        echo "Sent to $session"
    done
}

peek() {
    local session="$1"
    local lines="${2:-30}"

    if ! tmux has-session -t "$session" 2>/dev/null; then
        echo "Session $session does not exist" >&2
        return 1
    fi

    tmux capture-pane -t "$session" -p -S "-$lines"
}

logs() {
    local session="$1"
    local lines="${2:-}"
    local logfile="$LOG_DIR/$session.log"

    if [[ ! -f "$logfile" ]]; then
        echo "No log file for $session" >&2
        return 1
    fi

    if [[ -n "$lines" ]]; then
        tail -n "$lines" "$logfile"
    else
        cat "$logfile"
    fi
}

listen() {
    mkdir -p "$INBOX_DIR"

    echo "Listening for mob messages... (Ctrl+C to stop)"
    echo "---"

    touch "$INBOX_DIR/.listen-probe"

    tail -F "$INBOX_DIR"/*.jsonl 2>/dev/null | while read -r line; do
        [[ -z "$line" ]] && continue
        [[ "$line" == *"==>"* ]] && continue

        local msg_type msg_from msg_text ts time
        msg_type=$(echo "$line" | sed -n 's/.*"type":"\([^"]*\)".*/\1/p')
        msg_from=$(echo "$line" | sed -n 's/.*"from":"\([^"]*\)".*/\1/p')
        msg_text=$(echo "$line" | sed -n 's/.*"message":"\([^"]*\)".*/\1/p')
        ts=$(echo "$line" | sed -n 's/.*"ts":\([0-9]*\).*/\1/p')

        [[ -z "$msg_type" ]] && continue

        time=$(date -r "$ts" "+%H:%M:%S" 2>/dev/null || echo "??:??:??")

        case "$msg_type" in
            DONE)   printf "\033[32m" ;;
            REPORT) printf "\033[33m" ;;
            TASK)   printf "\033[36m" ;;
            *)      printf "\033[37m" ;;
        esac

        printf "[%s] %s → %s: %s\033[0m\n" "$time" "$msg_from" "$msg_type" "$msg_text"
    done
}

waiting() {
    local sessions
    sessions=$(tmux list-sessions -F "#{session_name}" 2>/dev/null | grep "^${SESSION_PREFIX}-" || true)

    if [[ -z "$sessions" ]]; then
        echo "No claude sessions running"
        return 0
    fi

    echo "$sessions" | while read -r session; do
        local content
        content=$(tmux capture-pane -t "$session" -p -S -20 2>/dev/null || true)

        local state="working"

        if echo "$content" | grep -qE "(Allow|Deny|Yes|No).*\?"; then
            state="PERMISSION PROMPT"
        elif echo "$content" | grep -qE "^>[[:space:]]*$"; then
            state="awaiting input"
        elif echo "$content" | grep -qE "\? \(y/n\)|\[Y/n\]|\[y/N\]"; then
            state="CONFIRMATION"
        fi

        if [[ "$state" != "working" ]]; then
            printf "%-30s %s\n" "$session" "$state"
        fi
    done
}

watch() {
    trap 'echo ""; exit 0' INT
    while true; do
        clear
        echo "=== MOB WATCH === $(date '+%H:%M:%S') ==="
        echo ""
        health
        echo ""
        local waiting_output
        waiting_output=$(waiting)
        if [[ -n "$waiting_output" ]]; then
            echo "WAITING FOR INPUT:"
            echo "$waiting_output"
        fi
        sleep 2
    done
}

usage() {
    cat <<EOF
mob - Orchestrate multiple Claude Code sessions

ARCHITECTURE:
    User ↔ Operator ↔ Coordinator (background) ↔ Workers

    - Operator: Your interface (opus). Shields you from worker noise.
    - Coordinator: Background orchestrator. Manages all workers.
    - Workers: Do the actual work (write code, research, etc.)

USAGE:
    mob <command> [args]

COMMANDS:
    start [id]              Start operator + coordinator, attach to operator
                            This is the quickest way to begin

    spawn <role> [id]       Create session and auto-prime based on role
                            Roles: operator, coord, worker, researcher, reviewer, planner
                            - operator: user interface (opus)
                            - coord: background orchestrator (sonnet)
                            - worker: full tools (read/write/bash)
                            - researcher: read-only (explore code, no edits)
                            - reviewer: read + test/lint commands
                            - planner: read-only with opus model

    spawn-quiet <role> [id] Create session WITHOUT auto-priming

    dispatch <role> <id> <task>
                            Spawn worker AND send task in one command
                            Example: dispatch worker 1 "Build the auth module"

    list                    List all claude-* sessions
    workers                 List worker sessions only
    coord                   Print coordinator session name
    operator                Print operator session name
    status                  Show detailed session status

    send <session> <msg>    Send message to a session
    broadcast <msg>         Send message to ALL sessions
    broadcast-workers <msg> Send message to all workers only

    peek <session> [lines]  Show last N lines from session (default: 30)
    logs <session> [lines]  Show session log file (optional: last N lines)
    waiting                 Show sessions waiting for input/permission
    watch                   Live dashboard with auto-refresh (Ctrl+C to exit)
    listen                  Stream all inbox messages in real-time

    attach <session>        Attach to a session (detach: Ctrl-b d)

    kill <session>          Kill a specific session
    killall                 Kill all claude-* sessions

HEALTH MONITORING:
    health                  Show health status with heartbeat freshness
    zombies                 List zombie sessions (Claude died but tmux persists)
    reap                    Kill all zombie sessions

OPERATOR COMMANDS (run from operator session):
    task <msg>              Send priority task to coordinator
    results                 Read coordinator's reports to you

COORDINATOR COMMANDS (run from coordinator session):
    priority                Read priority inbox (from operator)
    inbox                   Read worker inbox (completions, reports)
    report <msg>            Send report to operator

WORKER CALLBACKS (run from within a worker session):
    report <msg>            Queue status report for coordinator
    done <summary>          Queue completion and self-terminate
    ask <question>          Interrupt coordinator with question
    heartbeat               Record heartbeat (proves worker is alive)

EXAMPLES:
    # === QUICK START ===
    mob start                          # Spawns operator + coordinator, attaches to operator

    # === FROM OPERATOR: send task to coordinator ===
    mob task "Build a REST API with /users and /posts endpoints"

    # === FROM OPERATOR: check coordinator's reports ===
    mob results

    # === MONITOR ===
    mob health
    mob peek claude-coord-*            # See coordinator activity

    # === CLEANUP ===
    mob killall

EOF
}

main() {
    if [[ $# -lt 1 ]]; then
        usage
        exit 1
    fi

    local cmd="$1"
    shift

    case "$cmd" in
        spawn)
            [[ $# -lt 1 ]] && { echo "Usage: spawn <role> [id]" >&2; exit 1; }
            spawn "$@"
            ;;
        spawn-quiet)
            [[ $# -lt 1 ]] && { echo "Usage: spawn-quiet <role> [id]" >&2; exit 1; }
            spawn_quiet "$@"
            ;;
        dispatch)
            [[ $# -lt 3 ]] && { echo "Usage: dispatch <role> <id> <task>" >&2; exit 1; }
            dispatch "$@"
            ;;
        list)
            list_sessions
            ;;
        workers)
            workers
            ;;
        coord)
            coord
            ;;
        operator)
            operator
            ;;
        status)
            status
            ;;
        send)
            [[ $# -lt 2 ]] && { echo "Usage: send <session> <message>" >&2; exit 1; }
            send_message "$@"
            ;;
        broadcast)
            [[ $# -lt 1 ]] && { echo "Usage: broadcast <message>" >&2; exit 1; }
            broadcast "$@"
            ;;
        broadcast-workers)
            [[ $# -lt 1 ]] && { echo "Usage: broadcast-workers <message>" >&2; exit 1; }
            broadcast_workers "$@"
            ;;
        peek)
            [[ $# -lt 1 ]] && { echo "Usage: peek <session> [lines]" >&2; exit 1; }
            peek "$@"
            ;;
        logs)
            [[ $# -lt 1 ]] && { echo "Usage: logs <session> [lines]" >&2; exit 1; }
            logs "$@"
            ;;
        waiting)
            waiting
            ;;
        watch)
            watch
            ;;
        listen)
            listen
            ;;
        attach)
            [[ $# -lt 1 ]] && { echo "Usage: attach <session>" >&2; exit 1; }
            attach "$1"
            ;;
        kill)
            [[ $# -lt 1 ]] && { echo "Usage: kill <session>" >&2; exit 1; }
            kill_session "$1"
            ;;
        killall)
            kill_all
            ;;
        health)
            health
            ;;
        zombies)
            zombies
            ;;
        reap)
            reap
            ;;
        report)
            [[ $# -lt 1 ]] && { echo "Usage: report <message>" >&2; exit 1; }
            report "$@"
            ;;
        done)
            [[ $# -lt 1 ]] && { echo "Usage: done <summary>" >&2; exit 1; }
            done_task "$@"
            ;;
        ask)
            [[ $# -lt 1 ]] && { echo "Usage: ask <question>" >&2; exit 1; }
            ask_coord "$@"
            ;;
        inbox)
            inbox
            ;;
        inbox-count)
            inbox_count
            ;;
        task)
            [[ $# -lt 1 ]] && { echo "Usage: task <message>" >&2; exit 1; }
            task "$@"
            ;;
        priority)
            priority
            ;;
        results)
            results
            ;;
        heartbeat)
            heartbeat
            ;;
        crash)
            [[ $# -lt 1 ]] && { echo "Usage: crash <session>" >&2; exit 1; }
            crash_handler "$1"
            ;;
        start)
            start "$@"
            ;;
        help|--help|-h)
            usage
            ;;
        *)
            echo "Unknown command: $cmd" >&2
            usage
            exit 1
            ;;
    esac
}

main "$@"
